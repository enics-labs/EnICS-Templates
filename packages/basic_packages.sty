%----------------------------
%         Figures           %         
%----------------------------
% The graphicx package is the standard LaTeX graphics tool (though it's outdated)
% -------------------------------------------------------------------------------
\usepackage{graphicx}
% The subfig package provides \subfloat for sub-figures (replaces the obsolete "subfigure" package)
%   caption=false keeps the document class's own caption style (required by IEEEtran).
%   The acmart class ships its own sub-figure support, so it is skipped there.
% -----------------------------------------------------------------------------------------------
\ifacmjournal
\else
    \usepackage[caption=false,font=footnotesize]{subfig}
\fi
% The wrapfig package allows figures to be wrapped within text
% ---------------------------------------------------------------
% \usepackage{wrapfig} 
% The graphicspath option tells LaTeX the path to look for figures
% ---------------------------------------------------------------
%   The last two entries let a file inside Templates/ be compiled in place for a
%   quick preview: they are searched only after the project's own folders, so a
%   normal build from the project root is unaffected.
    \graphicspath{{./Figures/}{./}{../Figures/}{../}}

% The CAPTION package, has many options for figure captions, 
% but can change unwanted things, so prefer the TITLESEC package
% --------------------------------------------------------------
% \usepackage{caption}
	% Change spacing between captions and figure
    % ------------------------------------------
    %	\captionsetup{skip=2pt}
	%   \captionsetup{belowskip=-15pt}
	%   \captionsetup{aboveskip=2pt}
    % Change caption Font
    % -------------------
	%   \captionsetup{font={small,it}}
    \ifisf
        \usepackage[font=normal]{caption}
    \fi

%----------------------------
%         Tables            %         
%----------------------------
% \usepackage{adjustbox}
% The MULTIROW package enables table cells that span multiple rows 
% ----------------------------------------------------------------
\usepackage{multirow}
% The ARRAY package enhances tables
% ---------------------------------
\usepackage{array}
    % This defines "P" for centering a sized column
    % ---------------------------------------------
    \newcolumntype{P}[1]{>{\centering\arraybackslash}p{#1}}
    % this adds some spacing between table rows
    % ---------------------------------------------
    % \renewcommand{\arraystretch}{1.2} 
% The booktabs package enables advanced table formatting
% ------------------------------------------------------
\usepackage{booktabs}
    % This enables adding space in table rows, e.g., \ra{1.2}
    \newcommand{\ra}[1]{\renewcommand{\arraystretch}{#1}} 

