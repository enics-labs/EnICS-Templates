     %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
     %        Header and Footer         %
     %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% The FANCYHDR package controls headers and footers
\ifisf
    \usepackage{fancyhdr}
        \pagestyle{fancy}
        \fancyhf{}
        \pagenumbering{gobble} % Remove page numbering
\fi

\ifthesis
    \usepackage{fancyhdr}
        \setlength{\headheight}{15pt}
        \fancyhf{}
        \renewcommand{\headrulewidth}{0pt} % prevents header underline
        \fancyhead[LE, LO]{\scriptsize \truncate{0.47 \textwidth} \leftmark}
        \fancyhead[RE, RO]{\scriptsize \truncate{0.47 \textwidth} \rightmark}
        \fancyfoot[C]{\thepage}

    % The SECTSTY package controls the section style
    % ----------------------------------------------
        \WarningFilter{latex}{Command \underbar has changed.}
        \WarningFilter{latex}{Command \underline has changed.}
    \usepackage{sectsty}
        % This gets rid of some stupid warning due to the sectsty package
        % (pdfLaTeX only: under LuaLaTeX the fonts are Unicode already)
        \ifpdftex
            \usepackage[T1]{fontenc}
        \fi

    % For fontsize options see see https://latex-tutorial.com/changing-font-size/
    \chapternumberfont{\LARGE} 
    \chaptertitlefont{\LARGE}  

    % Without the TRUNCATE package, the PhD Thesis template breaks...
    \usepackage[fit, breakall]{truncate}

    \usepackage[page,toc,titletoc,title]{appendix}
\fi

