% The silence package suppresses specific warnings (see the \WarningFilter calls below).
% On some package versions it hangs (infinite loop) when loaded together with the acmart
% class, so it is skipped for the ACM Journal template. Loaded here rather than in
% packages/configuration.tex because \ifacmjournal must already be set to \acmjournaltrue
% by the calling template (see e.g. Templates/ACM_Journal.tex) by the time this runs.
\ifacmjournal
\else
    \usepackage{silence}
\fi


